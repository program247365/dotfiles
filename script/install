#!/usr/bin/env bash
#
# Run all dotfiles installers.

set -e

cd "$(dirname "$0")"/..

# Toolchain first: mise provides node, pnpm, python and bun for the rest.
export PATH="$HOME/.local/share/mise/shims:$PATH"
for installer in ./mise/install.sh ./node/install.sh; do
  sh -c "$installer"
done

# Everything else, sorted so the order is deterministic.
find . -name install.sh -not -path '*/node_modules/*' \
  -not -path './mise/*' -not -path './node/*' \
  | sort | while read -r installer ; do sh -c "${installer}" ; done
