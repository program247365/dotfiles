#!/usr/bin/env bash
#
# Run all dotfiles installers.

set -e

cd "$(dirname "$0")"/..

# mise installs node/bun/python for the installers that follow it.
export PATH="$HOME/.local/share/mise/shims:$PATH"

# Sorted so the order is deterministic: mise/ and node/ run before tools/.
find . -name install.sh -not -path '*/node_modules/*' | sort | while read -r installer ; do sh -c "${installer}" ; done
