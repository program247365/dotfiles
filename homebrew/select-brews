#!/bin/zsh
#
# Pick which Brewfile entries install on this machine.
#
# Every brew/cask/mas line is offered in a multi-select picker. Entries you
# deselect are written to the skip file, and homebrew/install.zsh filters
# them out of the Brewfile before running `brew bundle`. Taps and cask_args
# always apply. Re-run any time with `dot --select-brews`.

set -e

DOTFILES_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
BREWFILE="$DOTFILES_ROOT/Brewfile"
SKIP_FILE="${DOTFILES_BREW_SKIP:-$HOME/.config/dotfiles/brew-skip}"

if ! command -v sk >/dev/null 2>&1; then
  echo "  installing sk (the picker) before choosing brews"
  brew install sk
fi

# Reduce a Brewfile line to its identity, e.g. `cask 'docker'`.
entry_key() {
  sed -E "s/^((brew|cask|mas) '[^']+').*/\1/"
}

all="$(grep -E "^(brew|cask|mas) '" "$BREWFILE")"

preselect="$(mktemp)"
trap 'rm -f "$preselect"' EXIT
if [ -s "$SKIP_FILE" ]; then
  printf '%s\n' "$all" | grep -v -F -f "$SKIP_FILE" > "$preselect" || true
else
  printf '%s\n' "$all" > "$preselect"
fi

# skim >= 5 draws its UI on stderr, and bootstrap merges stderr into a pipe,
# so point the UI at the terminal explicitly.
selected="$(printf '%s\n' "$all" | sk --multi --layout reverse \
  --pre-select-file "$preselect" \
  --bind 'ctrl-a:select-all,ctrl-d:deselect-all' \
  --header 'Selected entries install on this machine (all selected to start). tab: toggle  ctrl-a: all  ctrl-d: none  enter: save  esc: cancel' \
  2>/dev/tty)" || {
  if [ -e "$SKIP_FILE" ]; then
    echo "  picker cancelled; skip list unchanged"
  else
    mkdir -p "$(dirname "$SKIP_FILE")"
    : > "$SKIP_FILE"
    echo "  picker cancelled; installing everything and not asking again ($SKIP_FILE)"
  fi
  exit 0
}

mkdir -p "$(dirname "$SKIP_FILE")"
comm -23 <(printf '%s\n' "$all" | entry_key | sort) \
         <(printf '%s\n' "$selected" | entry_key | sort) > "$SKIP_FILE"

skipped="$(wc -l < "$SKIP_FILE" | tr -d ' ')"
echo "  $skipped Brewfile entries will be skipped on this machine ($SKIP_FILE)"

# Offer to uninstall deselected entries that are already installed.
installed_formulae="$(brew list --formula -1 2>/dev/null)"
installed_casks="$(brew list --cask -1 2>/dev/null)"
to_remove=()
while IFS= read -r entry; do
  [ -n "$entry" ] || continue
  kind="${entry%% *}"
  name="${entry#* }"; name="${name//\'/}"
  short="${name##*/}"
  case "$kind" in
    brew) printf '%s\n' "$installed_formulae" | grep -qx "$short" && to_remove+=("$kind $name") ;;
    cask) printf '%s\n' "$installed_casks" | grep -qx "$short" && to_remove+=("$kind $name") ;;
  esac
done < "$SKIP_FILE"

if [ ${#to_remove[@]} -gt 0 ]; then
  {
    echo "  deselected but installed:"
    printf '    %s\n' "${to_remove[@]}"
    printf '  uninstall these %d now? [y/N] ' "${#to_remove[@]}"
  } > /dev/tty
  read -r answer < /dev/tty
  case "$answer" in
    [yY]*)
      for entry in "${to_remove[@]}"; do
        kind="${entry%% *}"; name="${entry#* }"
        if [ "$kind" = cask ]; then
          brew uninstall --cask "$name" || echo "  could not uninstall cask $name"
        else
          brew uninstall "$name" || echo "  could not uninstall $name"
        fi
      done ;;
    *) echo "  kept them installed; they just won't be managed by brew bundle here" ;;
  esac
fi
