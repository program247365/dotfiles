#!/bin/sh
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.

set -e

parentDirectory="$(cd "$( dirname "${ZSH_SOURCE[0]}" )" && pwd -P)"
dotfilesDirectory="$(cd "$( dirname "$parentDirectory" )" && pwd -P)"

displayUsageAndExit() {
	echo "dot -- dotfiles management"
	echo ""
	echo "Usage: dot [options]"
	echo ""
	echo "Options:"
	echo "  -e, --edit    Open dotfiles directory for editing"
	echo "  -s, --select-brews  Re-pick which Brewfile entries this machine gets, then install/uninstall to match"
	echo "  -h, --help    Show this help message and exit"
	exit
}

while test $# -gt 0; do
	case "$1" in
		"-h"|"--help")
			displayUsageAndExit
			;;
		"-e"|"--edit")
			exec "$EDITOR" "$dotfilesDirectory"
			exit
			;;
		"-s"|"--select-brews")
			export DOTFILES_SELECT_BREWS=1
			;;
		*)
			echo "Invalid option: $1"
			displayUsageAndExit
			;;
	esac
	shift
done

export ZSH=$HOME/.dotfiles

# Create ~/.kevin dirs (code, screenshots, ...) before anything points at them
sh $ZSH/script/custom_dirs.zsh

# Set macOS defaults
$ZSH/macos/set-defaults.zsh

# Install homebrew
$ZSH/homebrew/install.zsh 2>&1

# homebrew/install.zsh updates brew but runs in its own process, so put brew
# on this shell's PATH (a fresh machine has no ~/.zprofile entry loaded yet).
eval "$(/opt/homebrew/bin/brew shellenv)"

# Install software; keep going to migrations even if an installer failed
echo "› $ZSH/script/install"
install_status=0
$ZSH/script/install || install_status=$?

# Run migrations
echo "› Running migrations"
for script in "$ZSH/migrations"/*.zsh; do
	if [ -f "$script" ]; then
		echo "  Running migration: $(basename "$script")"
		"$script"
	fi
done

# Rebuild kit index after install/upgrade
echo "› kit index"
if command -v kit >/dev/null 2>&1; then
  kit index
fi

exit $install_status
