#!/usr/bin/env bash
#
# Run all dotfiles installers.

set -e

cd "$(dirname "$0")"/..

# Toolchain first: mise provides node, pnpm, python and bun for the rest.
export PATH="$HOME/.local/share/mise/shims:$PATH"
failed=()
run() { sh -c "$1" || failed+=("$1"); }

run ./mise/install.sh
run ./node/install.sh

# Everything else, sorted so the order is deterministic. One failing
# installer must not stop the rest, so failures are collected and reported.
# The list is read on fd 3: installers that read stdin (ssh -T in
# keeper-cli) would otherwise swallow the remaining entries.
while read -r installer <&3; do
  run "$installer"
done 3< <(find . -name install.sh -not -path '*/node_modules/*' \
  -not -path './mise/*' -not -path './node/*' | sort)

if [ ${#failed[@]} -gt 0 ]; then
  echo "› installers failed (fix, then re-run dot):"
  printf '    %s\n' "${failed[@]}"
  exit 1
fi
